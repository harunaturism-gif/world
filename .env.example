# FRONTEND CONFIG
VITE_WS_URL=ws://localhost:3001
VITE_BACKEND_URL=http://localhost:3001
VITE_WORLD_APP_ID=app_xxxxxxxxxxxxxxx
VITE_ENABLE_DEV_AUTH=false
# Explicit local-only room editor. Never use as production authorization.
VITE_ENABLE_DEV_ADMIN=false

# BACKEND CONFIG
NODE_ENV=development
PORT=3001
# Number of trusted reverse-proxy hops used to derive the client IP for rate limits (0-3).
TRUST_PROXY_HOPS=0
WORLD_RP_ID=rp_xxxxxxxxxxxxxxx
WORLD_RP_SIGNING_KEY=sk_xxxxxxxxxxxxxxx
APP_ORIGIN=http://localhost:5173
# Generate two independent random secrets containing at least 32 bytes each.
APP_SESSION_SECRET=
APP_IDENTITY_SECRET=
# Server-only persistence credentials. Never prefix either value with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Local memory persistence is allowed only with NODE_ENV=development.
ENABLE_DEV_MOCK_PERSISTENCE=false
# Comma-separated internal IDs only: user_ followed by exactly 64 lowercase hex characters.
ADMIN_BOOTSTRAP_USER_IDS=
# When true in development, a successfully verified user is bootstrapped as owner.
ENABLE_DEV_ADMIN=false
